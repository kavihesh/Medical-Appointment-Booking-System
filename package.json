{
  "name": "medical-appointment-booking-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MERN web app for booking medical appointments with doctors",
  "author": "Heshan Praveen",
  "license": "MIT",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "seed": "npm run seed -w server",
    "seed:reset": "npm run seed:reset -w server",
    "build": "npm run build -w client",
    "lint": "eslint . --max-warnings 0",
    "test": "npm test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0"
  }
}
