{
  "name": "@mab/server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB REST API for the Medical Appointment Booking System",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "seed:reset": "node --env-file-if-exists=.env src/seed.js --reset",
    "test": "node --test"
  },
  "dependencies": {
    "@mab/shared": "1.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "zod": "^4.6.7"
  }
}
