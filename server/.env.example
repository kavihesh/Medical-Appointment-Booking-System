# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB Atlas connection string, including the database name after the host.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medical_appointments?retryWrites=true&w=majority

# Port the API listens on.
PORT=5000

# Comma-separated list of front-end origins allowed by CORS.
CLIENT_ORIGIN=http://localhost:5173
